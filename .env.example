# Local dev (npm run dev) uses DATABASE_URL directly.
DATABASE_URL=postgres://comic:comic@localhost:5432/comic
UPLOAD_DIR=./uploads

# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# docker compose (server)
DB_PASSWORD=comic
# Set to false only while you serve over plain http (no domain / TLS yet).
COOKIE_SECURE=true
APP_PORT=3000
